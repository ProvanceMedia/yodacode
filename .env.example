# YodaCode — Environment Configuration
# Copy this to .env and fill in your values.
# chmod 600 .env — secrets should not be world-readable.

# ─── Claude Code Auth ─────────────────────────────────────────────────────
# Long-lived OAuth token from your Claude Max subscription.
# Generate via: claude setup-token (on a machine with a browser)
# Valid for 1 year. Do NOT set ANTHROPIC_API_KEY — that would use paid API credits.
CLAUDE_CODE_OAUTH_TOKEN=

# ─── Engine ───────────────────────────────────────────────────────────────
# Which AI runs a turn: 'claude' (Claude subscription, the token above) or
# 'codex' (ChatGPT subscription). An unknown value stops the agent at boot
# rather than quietly falling back to the wrong one.
# Change it with `yodacode change llm`, not by hand — switching also has to
# reconcile the crons and park the sessions.
YODA_ENGINE=claude

# Set by the installer once ChatGPT sign-in completes. Codex's credential is a
# FILE on the agent volume, not a value here, so this only records that setup
# happened — `yodacode doctor` is what checks it still works.
YODA_CODEX_SIGNED_IN=

# ─── Slack ────────────────────────────────────────────────────────────────
# Create a Slack app from the manifest at scripts/slack-app-manifest.yaml
# then copy these from the app config page.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=
SLACK_TEST_CHANNEL_ID=

# ─── Surfaces ─────────────────────────────────────────────────────────────
# Comma-separated list of enabled surfaces. Options: slack, whatsapp, googlechat, voice
YODA_SURFACES=slack

# ─── Reply Policy ─────────────────────────────────────────────────────────
# Slack user IDs the bot replies to in DMs (comma-separated)
YODA_DM_AUTHORIZED_USERS=
# Channel IDs where the bot replies on @-mention (comma-separated)
YODA_MENTION_CHANNELS=
# Restricted channels: channel:user pairs — only respond when that user mentions you
YODA_RESTRICTED_CHANNELS=
# User IDs authorised to send "stop" commands (comma-separated)
YODA_STOP_AUTHORIZED_USERS=

# ─── Model Config ─────────────────────────────────────────────────────────
# Primary model, per engine — a name only means something to its own engine, so
# each keeps its own setting and switching back restores what you had.
# Claude: leave empty for the engine's own default (claude-sonnet-5).
#   claude-fable-5-1 works here too; see docs/ENGINES.md before pointing a
#   scheduled task at it.
YODA_CLAUDE_MODEL=
# Codex: leave empty for gpt-5.6-terra (the vendor's balanced everyday model).
#   gpt-5.6-luna   fast and affordable
#   gpt-5.6-terra  balanced, everyday work
#   gpt-5.6-sol    latest frontier — strongest, and strong even at low effort
# Set with: yodacode model <name>
YODA_CODEX_MODEL=
# Fallback models tried when primary returns 529 (comma-separated)
YODA_CLAUDE_FALLBACK_MODELS=claude-haiku-4-5
# Max API retries before failing fast (default 3)
YODA_CLAUDE_MAX_RETRIES=3
# Hard timeout per claude invocation in ms (default 600000 = 10 min)
YODA_CLAUDE_TIMEOUT_MS=600000
# How a DM shows the working state: card (default) or shimmer.
# card    — the same status line channels get: says what the agent is doing,
#           ticks an elapsed clock, and survives a restart.
# shimmer — Slack's native indicator: prettier, but carries no detail, dies
#           with the process, and Slack rejects it inside a thread (so a DM
#           would show one thing at top level and another in a thread).
YODA_SLACK_DM_STATUS=card
# shimmer mode only: hand over to a status card once a run passes this (ms).
YODA_SLACK_DM_CARD_AFTER_MS=60000
# How often the working-state line re-renders while a long step runs, in ms
# (default 15000). Keeps the elapsed clock moving during a silent tool call.
# 0 turns the heartbeat off. Raising it cuts chat-API calls on busy installs.
YODA_STATUS_HEARTBEAT_MS=15000
# When a run counts as slow, in ms (default 240000 = 4 min). Wording only:
# past this the status says so out loud instead of repeating "still on it".
YODA_STATUS_SLOW_AFTER_MS=240000
# Reasoning effort: low | medium | high | xhigh | max. Empty = the model's
# default (high on Opus 4.7/4.8 and Sonnet 4.6). Higher = deeper reasoning, more
# quota per turn. No effect on Haiku; xhigh is Opus 4.7/4.8 only (others clamp to high).
YODA_CLAUDE_EFFORT=
# Advanced: thread-sticky escalation triggers. Say one of these in a thread to
# run it at xhigh effort (sticky); the "off" form (e.g. "xhigh off") stops it.
# Defaults shown — uncomment to override.
# YODA_EFFORT_ESCALATE_PATTERN=\b(xhigh|ultrathink)\b
# YODA_EFFORT_DEESCALATE_PATTERN=\b(?:xhigh|ultrathink|effort)\s+(?:off|stop|normal)\b|\bnormal\s+effort\b

# Persistent thread sessions (default on). Each thread resumes its own agent
# session across replies — prior turns and tool results carry over, and only
# new messages are sent per tick. Set 0 for fully-stateless replies.
# YODA_SESSION_RESUME=1
# Threads idle longer than this start a fresh session (ms, default 14 days).
# YODA_SESSION_MAX_AGE_MS=1209600000
# Rotate to a fresh session once one reply's total input (fresh + cached)
# reaches this many tokens — bounds per-reply cost on long-lived threads, at
# the price of dropping the whole session (the thread forgets). Default 0 =
# off: long threads compact and keep going instead, guided by the "When
# summarizing this conversation" section of CLAUDE.md. Set a number to cap cost.
# YODA_SESSION_ROTATE_TOKENS=0

# ─── Update notifications ─────────────────────────────────────────────────
# Once a day the bot checks for a newer release; when one appears it DMs you
# once, and the yodacode CLI shows a one-line banner. Set 0 to disable both.
# YODA_UPDATE_CHECK=1
# Forks: point the check at your own GitHub repo (owner/name).
# YODA_UPDATE_REPO=ProvanceMedia/yodacode
# Allowed tools for agent runs
YODA_ALLOWED_TOOLS=Bash,Read,Write,Edit,WebFetch,Glob,Grep,Task

# ─── WhatsApp (optional — only if 'whatsapp' is in YODA_SURFACES) ────────
# Phone number in international format, no '+' (e.g. 44XXXXXXXXXX)
YODA_WHATSAPP_AUTHORIZED=
YODA_WHATSAPP_PAIRING_PHONE=
# Group JIDs to respond in (comma-separated, default: ignore all groups)
YODA_WHATSAPP_GROUPS=

# ─── Voice (optional — only if 'voice' is in YODA_SURFACES) ───────────────
# Hands-free speech: say the wake word, give an instruction, hear the answer.
# The microphone stays in the browser — it listens, transcribes and speaks
# locally, and only TEXT crosses the wire. There is no speech vendor key here
# and nothing is metered.
#
# Setup:
#   1. Set YODA_VOICE_TOKEN below to a long random string (openssl rand -hex 24).
#   2. Add 'voice' to YODA_SURFACES.
#   3. Reach the dashboard over HTTPS or localhost — a browser will not grant
#      microphone access otherwise. See docs/VOICE.md.
#   4. Open /voice.html and allow the microphone.
#
# Shared secret for the /ws/voice socket. Empty = the socket refuses everyone.
YODA_VOICE_TOKEN=
# The identity a spoken turn runs as. Put this same value in
# YODA_STOP_AUTHORIZED_USERS if you want to be able to say "stop".
YODA_VOICE_USER_ID=voice-owner
# Whether the microphone runs continuously:
#   wake   — always transcribing, watching for the wake word. Properly
#            hands-free, and the only mode that works from across a room.
#   hotkey — the microphone is OFF until you press Space in the voice tab.
#            Nothing is transcribed in between, so nothing can false-trigger.
# Each browser can override this with the toggle on the page.
YODA_VOICE_MIC_MODE=wake
# What the browser listens for before it starts capturing (comma-separated,
# lowercase). Only counts at the START of what you say, so a mention in passing
# won't set it off. Pick two words you don't say by accident.
YODA_VOICE_WAKE_WORDS=hey yoda,hello yoda,ok yoda
# Hard cap on characters read aloud before the reply is trimmed at a sentence
# boundary. Long answers are fine on screen and unbearable in a room.
YODA_VOICE_MAX_SPEAK_CHARS=700

# ─── Google Chat (optional — only if 'googlechat' is in YODA_SURFACES) ────
# Inbound arrives over a Pub/Sub PULL subscription (no public endpoint); replies
# go via the Chat REST API. One-time Google Cloud setup: enable the Chat API +
# Pub/Sub API, create a service account + key, a topic (grant Publisher to
# chat-api-push@system.gserviceaccount.com) and a pull subscription (grant
# Subscriber to your SA), then set the Chat app Connection = "Cloud Pub/Sub".
# Keep the SA narrowly scoped (Pub/Sub Subscriber on that subscription + chat.bot).
# Service-account key: the JSON, or base64 of the JSON (cleaner as one line).
GOOGLE_CHAT_SA_KEY=
# Pull subscription resource name: projects/<PROJECT>/subscriptions/<SUB>
GOOGLE_CHAT_SUBSCRIPTION=
# Google user resource names ("users/123...") allowed to DM the bot (comma-sep).
YODA_GCHAT_AUTHORIZED=
# Space resource names ("spaces/AAA") the bot may act in when @mentioned (comma-sep).
YODA_GCHAT_SPACES=
# Set to 1 to open DMs to anyone the Chat app is visible to (skip the allowlist).
YODA_GCHAT_DM_OPEN=0

# ─── Web Dashboard (optional) ────────────────────────────────────────────
# compose publishes this on 127.0.0.1 only. SET A PASSWORD before you put it
# behind `tailscale serve` or a tunnel: an empty YODA_UI_PASS means no
# authentication at all, and anyone who reaches the port can read your memory
# files. Voice needs this port reachable, so it needs this password set.
YODA_UI_PORT=7890
YODA_UI_USER=yoda
YODA_UI_PASS=
# Extra origins allowed to open a WebSocket or POST to the API, beyond "same
# host as the request". Only needed behind a proxy that rewrites Host, e.g.
# https://yoda.your-tailnet.ts.net
YODA_UI_ALLOWED_ORIGINS=

# ─── Your API Keys ───────────────────────────────────────────────────────
# Add your own service keys below. These are read by refresh-capabilities.py
# to auto-generate CAPABILITIES.md. The agent uses them via curl.
#
# Examples:
# HUBSPOT_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# GITHUB_PAT=
# OPENAI_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# (Microsoft 365 has no client secret — it signs in as a public client)
# MICROSOFT_OAUTH_CLIENT_ID=
# BRAVE_SEARCH_API_KEY=

# ─── Sandbox ──────────────────────────────────────────────────────────────
# In the default container deployment the container itself is the isolation
# boundary (unprivileged user, no host access, keys held by the broker), so
# leave this off. The bubblewrap option below only applies to a bare-metal
# host install. 'off' (default) / 'auto' (bubblewrap, Linux host installs only).
YODA_SANDBOX=off

# ─── Tool-loop guardrails ────────────────────────────────────────────────
# Wraps every agent run with tool-call tracking. Detects repeat
# failures, no-progress loops, and runaway iteration counts. iteration_cap
# kills the run; warnings just surface in the placeholder.
YODA_MAX_ITERATIONS_SLACK=60
YODA_GUARDRAIL_ENABLED=1
YODA_GUARDRAIL_REPEAT_THRESHOLD=2
YODA_GUARDRAIL_NOPROGRESS_THRESHOLD=3

# ─── Skill self-generation (opt-in) ──────────────────────────────────────
# After ticks ≥30s OR ≥5 tool calls, fire a background agent run that
# decides whether to write workspace/skills/<slug>.md. Closed-loop self-
# improvement — costs one extra haiku call per long conversation.
YODA_SKILL_REFLECTOR_ENABLED=0
# YODA_SKILL_MIN_DURATION_MS=30000
# YODA_SKILL_MIN_TOOL_COUNT=5
# YODA_SKILL_REFLECTOR_MODEL=claude-haiku-4-5
# Per-reflection budget for surface ticks (ms, default 120000). Cron-triggered
# reflections get their own, more generous budget: YODA_CRON_REFLECTOR_TIMEOUT_MS
# (default 600000, 0 = unbounded) applies to both reflector kinds after crons.
# YODA_SKILL_REFLECTOR_TIMEOUT_MS=120000
# YODA_CRON_REFLECTOR_TIMEOUT_MS=600000

# ─── Memory self-generation (opt-in) ─────────────────────────────────────
# Mirror of the skill reflector but for durable FACTS (user-fact, feedback,
# project-state, reference). Appends to MEMORY.md or writes memory/<slug>.md.
YODA_MEMORY_REFLECTOR_ENABLED=0
# YODA_MEMORY_MIN_DURATION_MS=30000
# YODA_MEMORY_MIN_TOOL_COUNT=5
# YODA_MEMORY_REFLECTOR_MODEL=claude-haiku-4-5

# ─── Credential isolation (broker) ───────────────────────────────────────
# YodaCode runs de-rooted by default (docker compose). The service API keys
# above live ONLY in the broker container; the agent container never sees them
# and reaches services through the broker. Nothing to toggle. See docs/BROKER.md.
#
# PUID/PGID: set to your host user (run `id`) so files the agent writes into the
# bind-mounted workspace (memory, state, cron edits) stay owned by you.
PUID=1000
PGID=1000
# TZ: timezone for cron schedules + timestamps.
TZ=UTC
#
# Bare-metal (non-Docker host install) only: scripts/setup-broker.sh sets this.
# YODA_DEROOT=0
